				<Item class="ModuleScript" referent="RBX96A9FE367C6B4BB480AE2141EB276423">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- TalentLogic: pure, deterministic talent helpers reusable on both client and
-- server (R-T2..R-T4). No `game` state beyond Config, so the weighted roll can be
-- validated server-side and previewed client-side, and it is unit-testable.
--
-- A roll picks ONE talent weighted by its rarity's weight (rarer = less likely),
-- skipping any talent already at its maxLevel (e.g. extraDice caps at level 4).
-- Effect value scales linearly as perLevel * level.

local Config = script.Parent.Parent.Config
local Talents = require(Config.Talents)
local Rarities = require(Config.Rarities)

local TalentLogic = {}

export type TalentEffect = Talents.TalentEffect

-- An entry in the weighted roll pool.
export type PoolEntry = { id: string, weight: number }

-- Injected RNG returns a float in [0, 1). Defaults to math.random when omitted,
-- so tests can pass a deterministic stub (matching DamageFormula's convention).
type Rng = () -> number

-- True if `talentId` is at (or above) its cap and thus cannot be rolled further.
function TalentLogic.isMaxed(talentId: string, level: number): boolean
	local def = Talents.get(talentId)
	if not def then
		return true
	end
	return def.maxLevel ~= nil and level >= (def.maxLevel :: number)
end

-- Build the weighted roll pool from a talents map ({ [talentId]: level }).
-- Excludes maxed talents. Weight is the talent's rarity weight (higher = more
-- common). Iterates in Talents.Order for a stable, deterministic pool.
function TalentLogic.buildPool(talents: { [string]: number }): ({ PoolEntry }, number)
	local pool: { PoolEntry } = {}
	local total = 0
	for _, id in Talents.Order do
		local def = Talents.get(id)
		if def then
			local level = talents[id] or 0
			if not TalentLogic.isMaxed(id, level) then
				local rarityDef = Rarities.get(def.rarity)
				local weight = rarityDef and rarityDef.weight or 1
				if weight > 0 then
					table.insert(pool, { id = id, weight = weight })
					total += weight
				end
			end
		end
	end
	return pool, total
end

-- Pick one talent id from the pool, weighted by rarity (rarer = less likely).
-- Returns nil only when nothing is rollable (all talents maxed). `rng` returns
-- a float in [0, 1); defaults to math.random for production use.
function TalentLogic.pick(talents: { [string]: number }, rng: Rng?): string?
	local roll = rng or math.random
	local pool, total = TalentLogic.buildPool(talents)
	if total <= 0 then
		return nil
	end

	local target = roll() * total
	local cumulative = 0
	for _, entry in pool do
		cumulative += entry.weight
		if target < cumulative then
			return entry.id
		end
	end
	-- Floating-point safety: fall back to the last eligible entry.
	return pool[#pool].id
end

-- The effect magnitude a talent provides at a given level (perLevel * level).
-- Returns 0 for unknown talents.
function TalentLogic.effectValue(talentId: string, level: number): number
	local def = Talents.get(talentId)
	if not def then
		return 0
	end
	return def.perLevel * math.max(0, level)
end

-- ==================== display helpers ====================

-- Per-effect display metadata: a human label and whether it reads as a percent.
local EFFECT_META: { [string]: { label: string, percent: boolean } } = {
	flatAttack = { label = "Attack", percent = false },
	pctAttack = { label = "Attack", percent = true },
	critChance = { label = "Crit Chance", percent = true },
	extraReroll = { label = "Rerolls", percent = false },
	extraDice = { label = "Dice", percent = false },
	hp = { label = "HP", percent = false },
	lifesteal = { label = "Lifesteal", percent = true },
}

-- Human-readable label for an effect category (e.g. "pctAttack" -> "Attack").
function TalentLogic.effectLabel(effect: string): string
	local meta = EFFECT_META[effect]
	return meta and meta.label or effect
end

-- True if the effect is a fraction (0..1) that should render as a percentage.
function TalentLogic.isPercent(effect: string): boolean
	local meta = EFFECT_META[effect]
	return meta ~= nil and meta.percent
end

-- Format a talent's bonus at a level as a signed string, e.g. "+6 Attack",
-- "+15% Attack", "+2% Crit Chance", "+1 Die". Returns "-" for unknown talents.
function TalentLogic.formatBonus(talentId: string, level: number): string
	local def = Talents.get(talentId)
	if not def then
		return "-"
	end
	local value = TalentLogic.effectValue(talentId, level)
	local label = TalentLogic.effectLabel(def.effect)
	if TalentLogic.isPercent(def.effect) then
		local pct = value * 100
		local rounded = math.floor(pct * 10 + 0.5) / 10
		return ("+%s%% %s"):format(tostring(rounded), label)
	end
	return ("+%d %s"):format(math.floor(value + 0.5), label)
end

return TalentLogic
]]></ProtectedString>
						<string name="ScriptGuid">{C7E2840A-3E7B-436B-ACF1-0B9768A37949}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">TalentLogic</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6b5e38b5c27d020a0a5cc567000040be</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX19C7C04162F545E8ABB7B3A6EA9C9EE1">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- PlayerStats: pure aggregation of a player's effective combat stats from base
-- Balance values + equipped gear (via GearStats) + talents (via TalentLogic).
-- No `game` state beyond Config, so it is deterministic and unit-testable, and
-- is reused by CombatService (authoritative) and can back UI previews later.
--
-- Percent stats (crit/dodge/DR) and lifesteal are summed as fractions. Dice
-- unlock helpers derive the starting dice count for a run (R-C8, R-C21, R-C22).

local Config = script.Parent.Parent.Config
local Balance = require(Config.Balance)
local Slots = require(Config.Slots)
local GearStats = require(script.Parent.GearStats)
local TalentLogic = require(script.Parent.TalentLogic)
local Talents = require(Config.Talents)

local PlayerStats = {}

-- Effective, aggregated combat stats for a player entering combat.
export type Stats = {
	maxHp: number,
	flatAttack: number, -- flat added to the dice total before the % bonus
	pctAttack: number, -- fractional attack bonus (e.g. 0.25 = +25%)
	critChance: number,
	critMultiplier: number,
	dodgeChance: number,
	damageReduction: number,
	healAmount: number,
	lifesteal: number,
	extraRerolls: number, -- rerolls beyond Balance.Dice.baseRerolls
	extraDice: number, -- dice pre-unlocked from the extraDice talent
}

-- Minimal shape PlayerStats needs from a profile; PlayerData satisfies it.
export type StatSource = {
	gear: { [string]: { id: string, rarity: string } },
	equipped: { [string]: string? },
	slotLevels: { [string]: number },
	talents: { [string]: number },
	startingDiceUpgrade: number?,
	globalStatBonus: { [string]: number }?,
}

-- Fresh stats table seeded with the player's base values from Balance.
local function baseStats(): Stats
	local p = Balance.Player
	return {
		maxHp = p.baseHp,
		flatAttack = p.baseAttackFlat,
		pctAttack = 0,
		critChance = p.baseCritChance,
		critMultiplier = p.baseCritMultiplier,
		dodgeChance = p.baseDodgeChance,
		damageReduction = p.baseDamageReduction,
		healAmount = p.baseHealAmount,
		lifesteal = p.baseLifesteal,
		extraRerolls = 0,
		extraDice = 0,
	}
end

-- Add an equipped gear stat to the matching aggregate field.
local function applyGearStat(stats: Stats, stat: string, value: number)
	if stat == "hp" then
		stats.maxHp += value
	elseif stat == "attack" then
		stats.flatAttack += value
	elseif stat == "critChance" then
		stats.critChance += value
	elseif stat == "dodgeChance" then
		stats.dodgeChance += value
	elseif stat == "damageReduction" then
		stats.damageReduction += value
	elseif stat == "healAmount" then
		stats.healAmount += value
	end
end

-- Add a talent's effect (at its current level) to the matching aggregate field.
local function applyTalent(stats: Stats, effect: string, value: number)
	if effect == "flatAttack" then
		stats.flatAttack += value
	elseif effect == "pctAttack" then
		stats.pctAttack += value
	elseif effect == "critChance" then
		stats.critChance += value
	elseif effect == "hp" then
		stats.maxHp += value
	elseif effect == "lifesteal" then
		stats.lifesteal += value
	elseif effect == "extraReroll" then
		stats.extraRerolls += value
	elseif effect == "extraDice" then
		stats.extraDice += value
	end
end

-- Aggregate every source into a single Stats table.
function PlayerStats.compute(source: StatSource): Stats
	local stats = baseStats()

	-- Equipped gear: each slot's gear contributes its slot-scaled stat magnitude.
	for _, slotId in Slots.Order do
		local uid = source.equipped[slotId]
		if uid then
			local inst = source.gear[uid]
			if inst then
				local slotLevel = source.slotLevels[slotId] or 1
				local gearStat = GearStats.compute(inst.id, inst.rarity, slotLevel)
				if gearStat then
					applyGearStat(stats, gearStat.stat, gearStat.value)
				end
			end
		end
	end

	-- Talents: every defined talent at its current (possibly 0) level.
	for _, talentId in Talents.Order do
		local def = Talents.get(talentId)
		if def then
			local level = source.talents[talentId] or 0
			if level > 0 then
				applyTalent(stats, def.effect, TalentLogic.effectValue(talentId, level))
			end
		end
	end

	-- Global level-up bonuses (R-C22): keys map directly onto Stats fields, so a
	-- new gain category needs only a Balance/config entry and no logic change.
	if source.globalStatBonus then
		for statName, value in source.globalStatBonus do
			if type(value) == "number" and (stats :: any)[statName] ~= nil then
				(stats :: any)[statName] += value
			end
		end
	end

	return stats
end

-- Dice pre-unlocked at chapter entry: base + permanent starting-dice upgrade +
-- the extraDice talent, clamped to [1, maxDice] (ARCHITECTURE 6, R-C8/C22).
function PlayerStats.startingDice(source: StatSource, stats: Stats?): number
	local resolved = stats or PlayerStats.compute(source)
	local total = Balance.Dice.startingDice + (source.startingDiceUpgrade or 0) + resolved.extraDice
	return math.clamp(math.floor(total), 1, Balance.Dice.maxDice)
end

return PlayerStats
]]></ProtectedString>
						<string name="ScriptGuid">{5A551B9A-8F12-4089-8F2D-F68F4712746E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">PlayerStats</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">4ccecf2ca5bfce970a7277e800000d55</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXD37536B8B99C4DC0A1784BE9BB7D8BA6">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- CombatEngine: the pure, deterministic combat state machine (ARCHITECTURE 6,
-- R-C1..R-C23). It owns chapter/stage/turn flow, enemy spawning, dice, damage,
-- enemy actions, per-chapter XP/dice unlock, HP carryover, stage advance, chapter
-- completion, and the pick-3 trait offer at 5 dice. It has NO dependency on
-- `game`, Players, remotes, or DataService: all randomness is injected and all
-- state lives in the passed-in Battle table. This keeps combat unit-simulatable
-- (see tests/CombatSim) while CombatService stays a thin authoritative wrapper
-- (validation + persistence + replication).

local Config = script.Parent.Parent.Config
local Types = require(script.Parent.Parent.Types)
local Balance = require(Config.Balance)
local Chapters = require(Config.Chapters)
local Enemies = require(Config.Enemies)
local Traits = require(Config.Traits)
local DiceHands = require(script.Parent.DiceHands)
local DamageFormula = require(script.Parent.DamageFormula)
local PlayerStats = require(script.Parent.PlayerStats)

local CombatEngine = {}

type Rng = () -> number

-- Per-enemy behaviour kept server-side only (not replicated); parallels the
-- replicated CombatEnemy by uid.
export type EnemyRuntime = {
	attack: number,
	heal: number,
	shield: number,
	actions: Enemies.ActionWeights,
	isBoss: boolean,
}

-- Transient combat context that never leaves the server (RNG, enemy behaviour,
-- uid allocation, trait-offer bookkeeping).
export type Context = {
	stats: PlayerStats.Stats,
	enemyRuntime: { [string]: EnemyRuntime },
	rng: Rng,
	uidCounter: number,
	traitOffered: boolean,
	traitOffer: { string }?,
}

-- A live battle = the replicated state plus its private context.
export type Battle = {
	state: Types.CombatState,
	ctx: Context,
}

export type EnemyActionLog = {
	uid: string,
	action: string,
	amount: number,
	dodged: boolean?,
}

-- Summary of one player attack (and any enemy counter-turn) for feedback + tests.
export type AttackResult = {
	hand: string,
	multiplier: number,
	diceTotal: number,
	damage: number,
	crit: boolean,
	targetUid: string,
	killed: boolean,
	xpGained: number,
	stageCleared: boolean,
	enemyActions: { EnemyActionLog },
	outcome: string, -- resulting phase after the turn resolved
}

-- ==================== small helpers ====================

local function rollDie(rng: Rng): number
	return math.floor(rng() * Balance.Dice.faces) + 1
end

local function newUid(ctx: Context): string
	ctx.uidCounter += 1
	return "e" .. tostring(ctx.uidCounter)
end

-- Base player stats layered with any active per-battle traits (R-C23).
local function effectiveStats(battle: Battle): PlayerStats.Stats
	local eff = table.clone(battle.ctx.stats)
	for _, traitId in battle.state.activeTraits do
		local def = Traits.get(traitId)
		if def then
			local e = def.effect
			local v = def.value
			if e == "flatAttack" then
				eff.flatAttack += v
			elseif e == "pctAttack" then
				eff.pctAttack += v
			elseif e == "critChance" then
				eff.critChance += v
			elseif e == "critMultiplier" then
				eff.critMultiplier += v
			elseif e == "extraReroll" then
				eff.extraRerolls += v
			elseif e == "lifesteal" then
				eff.lifesteal += v
			elseif e == "damageReduction" then
				eff.damageReduction += v
			elseif e == "healAmount" then
				eff.healAmount += v
			end
		end
	end
	return eff
end

-- Weighted enemy action pick (R-C7). Injected rng keeps it deterministic.
local function pickAction(weights: Enemies.ActionWeights, rng: Rng): string
	local total = weights.attack + weights.heal + weights.shield + weights.nothing
	if total <= 0 then
		return "nothing"
	end
	local target = rng() * total
	local cumulative = weights.attack
	if target < cumulative then
		return "attack"
	end
	cumulative += weights.heal
	if target < cumulative then
		return "heal"
	end
	cumulative += weights.shield
	if target < cumulative then
		return "shield"
	end
	return "nothing"
end

-- ==================== spawning ====================

-- Populate state.enemies (and ctx.enemyRuntime) for the current stage (R-C2).
-- Boss stages spawn exactly one boss-scaled enemy; normal stages spawn a random
-- 1..3 drawn from the pool. Per-chapter difficulty ramp scales hp/attack.
local function spawnStage(battle: Battle)
	local state = battle.state
	local ctx = battle.ctx
	local chapter = Chapters.get(state.chapterId)
	assert(chapter, ("CombatEngine: unknown chapter %s"):format(tostring(state.chapterId)))
	local stage = chapter.stages[state.stageIndex]
	assert(stage, ("CombatEngine: chapter %d has no stage %d"):format(state.chapterId, state.stageIndex))

	state.enemies = {}
	ctx.enemyRuntime = {}

	local count: number
	if stage.boss then
		count = 1
	else
		local span = stage.maxEnemies - stage.minEnemies
		count = stage.minEnemies + math.floor(ctx.rng() * (span + 1))
		count = math.clamp(count, 1, 3) -- enemy count is 1..3 (R-C2)
	end

	local hpRamp = 1 + Balance.Enemy.hpPerChapter * (state.chapterId - 1)
	local atkRamp = 1 + Balance.Enemy.attackPerChapter * (state.chapterId - 1)

	for _ = 1, count do
		local poolIndex = math.floor(ctx.rng() * #stage.enemyPool) + 1
		local archetypeId = stage.enemyPool[poolIndex]
		local def = Enemies.get(archetypeId)
		if def then
			local hp = def.hp * hpRamp
			local attack = def.attack * atkRamp
			if stage.boss then
				hp *= Balance.Enemy.bossHpMultiplier
				attack *= Balance.Enemy.bossAttackMultiplier
			end
			local maxHp = math.floor(hp + 0.5)
			local uid = newUid(ctx)
			table.insert(state.enemies, {
				uid = uid,
				archetype = def.id,
				hp = maxHp,
				maxHp = maxHp,
				shield = 0,
			})
			ctx.enemyRuntime[uid] = {
				attack = attack,
				heal = def.heal,
				shield = def.shield,
				actions = def.actions,
				isBoss = stage.boss,
			}
		end
	end
end

-- ==================== dice ====================

local function rollAllDice(battle: Battle)
	local dice: { Types.Die } = {}
	for i = 1, battle.state.unlockedDice do
		dice[i] = { value = rollDie(battle.ctx.rng), locked = false }
	end
	battle.state.dice = dice
end

-- Grow the dice array to match unlockedDice after a mid-battle unlock, without
-- disturbing existing dice (they re-randomize at the next turn start anyway).
local function syncDiceCount(battle: Battle)
	local dice = battle.state.dice
	while #dice < battle.state.unlockedDice do
		table.insert(dice, { value = rollDie(battle.ctx.rng), locked = false })
	end
end

-- Rerolls granted at the start of a turn: base + talent/trait extras (R-C11).
local function turnRerolls(battle: Battle): number
	local eff = effectiveStats(battle)
	return math.max(0, math.floor(Balance.Dice.baseRerolls + eff.extraRerolls))
end

-- ==================== trait offer (R-C23) ====================

-- Pick 3 distinct traits from the pool using the injected rng.
local function makeTraitOffer(ctx: Context): { string }
	local pool = table.clone(Traits.Order)
	local offer: { string } = {}
	local n = math.min(3, #pool)
	for _ = 1, n do
		local idx = math.floor(ctx.rng() * #pool) + 1
		table.insert(offer, pool[idx])
		table.remove(pool, idx)
	end
	return offer
end

-- Start the next player turn. The first time the run reaches the dice cap it
-- enters TraitPick (offering 3 traits) instead of PlayerTurn; otherwise it
-- re-randomizes all dice, clears locks, and resets rerolls (R-C9, R-C10).
function CombatEngine.beginNextTurn(battle: Battle)
	local state = battle.state
	local ctx = battle.ctx
	if not ctx.traitOffered and state.unlockedDice >= Balance.Dice.maxDice then
		ctx.traitOffer = makeTraitOffer(ctx)
		state.phase = "TraitPick"
		return
	end
	state.phase = "PlayerTurn"
	state.rerollsLeft = turnRerolls(battle)
	rollAllDice(battle)
end

-- ==================== per-chapter XP & dice unlock (R-C21) ====================

local function xpToNext(level: number): number
	return Balance.PerChapter.baseXp + (level - 1) * Balance.PerChapter.xpPerLevel
end

-- Grant XP for a kill and process any resulting level-ups (each unlocks a die up
-- to the cap). Returns the XP granted.
local function grantKillXp(battle: Battle, isBoss: boolean): number
	local state = battle.state
	local gained = if isBoss then Balance.PerChapter.xpPerBossKill else Balance.PerChapter.xpPerEnemyKill
	local pc = state.perChapter
	pc.xp += gained
	while pc.xp >= xpToNext(pc.level) do
		pc.xp -= xpToNext(pc.level)
		pc.level += 1
		if state.unlockedDice < Balance.Dice.maxDice then
			state.unlockedDice = math.min(Balance.Dice.maxDice, state.unlockedDice + Balance.PerChapter.diceUnlockPerLevel)
			syncDiceCount(battle)
		end
	end
	return gained
end

-- ==================== enemy turn ====================

-- Each living enemy takes exactly one weighted action (R-C6, R-C7). Incoming
-- attacks resolve dodge -> DR -> shield -> HP (R-C15/C16). Sets phase to "Lost"
-- and stops early if the player dies.
local function enemyTurn(battle: Battle, result: AttackResult)
	local state = battle.state
	local ctx = battle.ctx
	local eff = effectiveStats(battle)

	for _, enemy in state.enemies do
		if enemy.hp > 0 then
			local rt = ctx.enemyRuntime[enemy.uid]
			if rt then
				local action = pickAction(rt.actions, ctx.rng)
				local entry: EnemyActionLog = { uid = enemy.uid, action = action, amount = 0 }
				if action == "attack" then
					local dodged = DamageFormula.rollDodge(eff.dodgeChance, ctx.rng)
					local res = DamageFormula.resolveIncomingDamage({
						incoming = rt.attack,
						damageReduction = eff.damageReduction,
						dodged = dodged,
						shield = state.player.shield,
						hp = state.player.hp,
					})
					state.player.shield = res.shield
					state.player.hp = res.hp
					entry.amount = res.hpLost + res.shieldAbsorbed
					entry.dodged = res.dodged
					table.insert(result.enemyActions, entry)
					if state.player.hp <= 0 then
						state.phase = "Lost"
						return
					end
				elseif action == "heal" then
					local before = enemy.hp
					enemy.hp = math.min(enemy.maxHp, enemy.hp + rt.heal)
					entry.amount = enemy.hp - before
					table.insert(result.enemyActions, entry)
				elseif action == "shield" then
					enemy.shield += rt.shield
					entry.amount = rt.shield
					table.insert(result.enemyActions, entry)
				else
					table.insert(result.enemyActions, entry)
				end
			end
		end
	end
end

-- ==================== public: create + player actions ====================

export type NewBattleParams = {
	chapterId: number,
	stats: PlayerStats.Stats,
	startingDice: number,
	rng: Rng?,
}

-- Create a fresh battle for a chapter: full HP, stage 1 spawned, first turn begun
-- (which may be a TraitPick if the run already starts at the dice cap).
function CombatEngine.newBattle(params: NewBattleParams): Battle
	local rng = params.rng or math.random
	local unlocked = math.clamp(math.floor(params.startingDice), 1, Balance.Dice.maxDice)
	local maxHp = math.floor(params.stats.maxHp + 0.5)

	local state: Types.CombatState = {
		chapterId = params.chapterId,
		stageIndex = 1,
		phase = "PlayerTurn",
		enemies = {},
		player = { hp = maxHp, maxHp = maxHp, shield = 0 },
		perChapter = { level = 1, xp = 0 },
		dice = {},
		unlockedDice = unlocked,
		rerollsLeft = Balance.Dice.baseRerolls,
		activeTraits = {},
	}
	local ctx: Context = {
		stats = params.stats,
		enemyRuntime = {},
		rng = rng,
		uidCounter = 0,
		traitOffered = false,
		traitOffer = nil,
	}
	local battle: Battle = { state = state, ctx = ctx }

	spawnStage(battle)
	CombatEngine.beginNextTurn(battle)
	return battle
end

-- Toggle a die's lock (R-C10). Only valid on the player's turn.
function CombatEngine.toggleLock(battle: Battle, index: number): boolean
	local state = battle.state
	if state.phase ~= "PlayerTurn" then
		return false
	end
	local die = state.dice[index]
	if not die then
		return false
	end
	die.locked = not die.locked
	return true
end

-- Reroll only the unlocked dice, consuming one reroll (R-C11).
function CombatEngine.reroll(battle: Battle): boolean
	local state = battle.state
	if state.phase ~= "PlayerTurn" then
		return false
	end
	if state.rerollsLeft <= 0 then
		return false
	end
	for _, die in state.dice do
		if not die.locked then
			die.value = rollDie(battle.ctx.rng)
		end
	end
	state.rerollsLeft -= 1
	return true
end

-- Choose one of the offered traits (R-C23), apply it for the battle, and begin
-- the (now trait-unlocked) player turn.
function CombatEngine.chooseTrait(battle: Battle, traitId: string): boolean
	local state = battle.state
	local ctx = battle.ctx
	if state.phase ~= "TraitPick" then
		return false
	end
	local offer = ctx.traitOffer
	if not offer then
		return false
	end
	local valid = false
	for _, id in offer do
		if id == traitId then
			valid = true
			break
		end
	end
	if not valid then
		return false
	end

	table.insert(state.activeTraits, traitId)
	ctx.traitOffered = true
	ctx.traitOffer = nil
	CombatEngine.beginNextTurn(battle)
	return true
end

-- Resolve a player attack on the enemy at `targetIndex`, then (unless the stage
-- was cleared) resolve the enemy turn and begin the next player turn. Returns a
-- summary, or nil if the action was illegal (wrong phase / dead-or-missing
-- target). Terminal outcomes set state.phase to "Won" or "Lost".
function CombatEngine.attack(battle: Battle, targetIndex: number): AttackResult?
	local state = battle.state
	local ctx = battle.ctx
	if state.phase ~= "PlayerTurn" then
		return nil
	end
	local enemy = state.enemies[targetIndex]
	if not enemy or enemy.hp <= 0 then
		return nil
	end

	local eff = effectiveStats(battle)

	local diceTotal = 0
	local values: { number } = {}
	for _, die in state.dice do
		table.insert(values, die.value)
		diceTotal += die.value
	end
	local hand = DiceHands.evaluate(values)
	local crit = DamageFormula.rollCrit(eff.critChance, ctx.rng)
	local dmg = DamageFormula.computePlayerDamage({
		diceTotal = diceTotal,
		flatBonus = eff.flatAttack,
		pctBonus = eff.pctAttack,
		handMultiplier = hand.multiplier,
		crit = crit,
		critMultiplier = eff.critMultiplier,
		lifesteal = eff.lifesteal,
	})

	-- Apply to the selected enemy: shield first, overflow to HP (mirrors R-C15).
	local dealt = dmg.damage
	local shieldAbsorbed = math.min(enemy.shield, dealt)
	enemy.shield -= shieldAbsorbed
	local overflow = dealt - shieldAbsorbed
	enemy.hp = math.max(0, enemy.hp - overflow)

	-- Lifesteal heals the player from the final damage (R-C14 talent/trait).
	if dmg.lifestealHeal > 0 then
		state.player.hp = math.min(state.player.maxHp, state.player.hp + dmg.lifestealHeal)
	end

	local result: AttackResult = {
		hand = hand.hand,
		multiplier = hand.multiplier,
		diceTotal = diceTotal,
		damage = dealt,
		crit = crit,
		targetUid = enemy.uid,
		killed = false,
		xpGained = 0,
		stageCleared = false,
		enemyActions = {},
		outcome = state.phase,
	}

	if enemy.hp <= 0 then
		local rt = ctx.enemyRuntime[enemy.uid]
		result.killed = true
		result.xpGained = grantKillXp(battle, rt ~= nil and rt.isBoss or false)
		for i, e in state.enemies do
			if e.uid == enemy.uid then
				table.remove(state.enemies, i)
				break
			end
		end
		ctx.enemyRuntime[enemy.uid] = nil
	end

	-- Stage cleared? (R-C4/C5) The killing blow ends the stage before enemies act.
	if #state.enemies == 0 then
		local chapter = Chapters.get(state.chapterId)
		local finalStage = chapter and state.stageIndex >= #chapter.stages
		if finalStage then
			state.phase = "Won"
			result.outcome = "Won"
			return result
		end
		state.stageIndex += 1
		spawnStage(battle) -- HP carries over: player.hp is untouched (R-C19)
		CombatEngine.beginNextTurn(battle)
		result.stageCleared = true
		result.outcome = state.phase
		return result
	end

	-- Otherwise every living enemy takes its turn (R-C6).
	enemyTurn(battle, result)
	if state.phase == "Lost" then
		result.outcome = "Lost"
		return result
	end

	CombatEngine.beginNextTurn(battle)
	result.outcome = state.phase
	return result
end

-- Current best hand for the dice on the table (UI/feedback helper).
function CombatEngine.currentHand(battle: Battle): DiceHands.HandResult
	local values: { number } = {}
	for _, die in battle.state.dice do
		table.insert(values, die.value)
	end
	return DiceHands.evaluate(values)
end

return CombatEngine
]]></ProtectedString>
