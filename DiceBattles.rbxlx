					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Talents: passive, permanent talent definitions (R-T1..R-T4).
-- All talents exist from the start at level 0; a rarity-weighted roll (R-T2)
-- increases one talent's level by 1. Effect value scales as perLevel * level.
-- Levels are uncapped except extraDice, which caps at maxLevel = 4 (the 5th die).

-- Effect categories (R-T4).
export type TalentEffect =
	"flatAttack"
	| "pctAttack"
	| "critChance"
	| "extraReroll"
	| "extraDice"
	| "hp"
	| "lifesteal"

export type TalentDef = {
	id: string,
	name: string,
	rarity: string, -- Rarities.Defs key (biases roll weight)
	effect: TalentEffect,
	perLevel: number, -- value added per level
	maxLevel: number?, -- nil = uncapped
	icon: string,
	desc: string, -- plain-language explanation shown in the detail popup
}

local Talents = {}

Talents.Order = {
	"Sharpen",
	"Vitality",
	"Berserk",
	"Precision",
	"LuckyHand",
	"Vampiric",
	"Multiroll",
}

Talents.Defs = {
	Sharpen = { id = "Sharpen", name = "Sharpen", rarity = "Common", effect = "flatAttack", perLevel = 2, icon = "talent/flatAttack", desc = "Permanently adds flat attack power to every hit." },
	Vitality = { id = "Vitality", name = "Vitality", rarity = "Common", effect = "hp", perLevel = 10, icon = "talent/hp", desc = "Raises your maximum health so you survive longer." },
	Berserk = { id = "Berserk", name = "Berserk", rarity = "Uncommon", effect = "pctAttack", perLevel = 0.05, icon = "talent/pctAttack", desc = "Increases your total attack damage by a percentage." },
	Precision = { id = "Precision", name = "Precision", rarity = "Rare", effect = "critChance", perLevel = 0.02, icon = "talent/critChance", desc = "Improves your chance to land a critical hit for bonus damage." },
	LuckyHand = { id = "LuckyHand", name = "Lucky Hand", rarity = "Legendary", effect = "extraReroll", perLevel = 1, icon = "talent/extraReroll", desc = "Grants an extra dice reroll each battle to chase better hands." },
	Vampiric = { id = "Vampiric", name = "Vampiric", rarity = "Rare", effect = "lifesteal", perLevel = 0.03, icon = "talent/lifesteal", desc = "Heals you for a portion of the damage you deal." },
	Multiroll = { id = "Multiroll", name = "Multiroll", rarity = "Legendary", effect = "extraDice", perLevel = 1, maxLevel = 4, icon = "talent/extraDice", desc = "Rolls an additional die each turn (up to +4 dice)." },
} :: { [string]: TalentDef }

function Talents.get(id: string): TalentDef?
	return Talents.Defs[id]
end

return Talents
]]></ProtectedString>
						<string name="ScriptGuid">{8A5CFE96-F182-4BB8-BE98-3CCEAD394F4D}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Talents</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6b5e38b5c27d020a0a5cc56700000f31</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4146ED4A243B43ED88A4CEB8567EAEBB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Traits: per-battle trait pool offered as a pick-3 when the player reaches 5
-- active dice (R-C23). Traits are temporary and apply for the current battle
-- only. Effects reuse the same categories as talents plus battle-only tweaks.

export type TraitEffect =
	"flatAttack"
	| "pctAttack"
	| "critChance"
	| "critMultiplier"
	| "extraReroll"
	| "lifesteal"
	| "damageReduction"
	| "healAmount"

export type TraitDef = {
	id: string,
	name: string,
	effect: TraitEffect,
	value: number, -- flat amount applied for the battle
	description: string,
	icon: string,
}

local Traits = {}

Traits.Order = {
	"GlassCannon",
	"SteadyHands",
	"KeenEye",
	"Executioner",
	"Bloodthirst",
	"IronSkin",
	"SecondWind",
}

Traits.Defs = {
	GlassCannon = { id = "GlassCannon", name = "Glass Cannon", effect = "pctAttack", value = 0.5, description = "+50% attack for this battle.", icon = "trait/pctAttack" },
	SteadyHands = { id = "SteadyHands", name = "Steady Hands", effect = "extraReroll", value = 2, description = "+2 rerolls each turn this battle.", icon = "trait/extraReroll" },
	KeenEye = { id = "KeenEye", name = "Keen Eye", effect = "critChance", value = 0.15, description = "+15% crit chance this battle.", icon = "trait/critChance" },
	Executioner = { id = "Executioner", name = "Executioner", effect = "critMultiplier", value = 1.0, description = "Crits deal an extra x1 this battle.", icon = "trait/critMultiplier" },
	Bloodthirst = { id = "Bloodthirst", name = "Bloodthirst", effect = "lifesteal", value = 0.2, description = "Heal for 20% of damage dealt.", icon = "trait/lifesteal" },
	IronSkin = { id = "IronSkin", name = "Iron Skin", effect = "damageReduction", value = 0.2, description = "+20% damage reduction this battle.", icon = "trait/damageReduction" },
	SecondWind = { id = "SecondWind", name = "Second Wind", effect = "healAmount", value = 25, description = "+25 heal amount this battle.", icon = "trait/healAmount" },
} :: { [string]: TraitDef }

function Traits.get(id: string): TraitDef?
	return Traits.Defs[id]
end

return Traits
]]></ProtectedString>
